{
  "info": {
    "name": "IS 5600 Lab 5 Fullstack Prints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "productId", "value": "REPLACE_WITH_PRODUCT_ID" },
    { "key": "orderId", "value": "REPLACE_WITH_ORDER_ID" }
  ],
  "item": [
    {
      "name": "List Products",
      "request": { "method": "GET", "url": "{{baseUrl}}/products" }
    },
    {
      "name": "Get Product",
      "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" }
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"likes\": 100\n}" },
        "url": "{{baseUrl}}/products/{{productId}}"
      }
    },
    {
      "name": "Delete Product",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/products/{{productId}}" }
    },
    {
      "name": "List Orders",
      "request": { "method": "GET", "url": "{{baseUrl}}/orders" }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"buyerEmail\": \"joseph@example.com\",\n  \"products\": [\"REPLACE_WITH_PRODUCT_ID\"],\n  \"status\": \"CREATED\"\n}"
        },
        "url": "{{baseUrl}}/orders"
      }
    },
    {
      "name": "Get Order",
      "request": { "method": "GET", "url": "{{baseUrl}}/orders/{{orderId}}" }
    },
    {
      "name": "Update Order",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"COMPLETED\"\n}" },
        "url": "{{baseUrl}}/orders/{{orderId}}"
      }
    },
    {
      "name": "Delete Order",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/orders/{{orderId}}" }
    }
  ]
}